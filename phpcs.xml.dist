<?xml version="1.0"?>
<ruleset name="WC Gateway Boilerplate">
	<description>Minimal WordPress coding standards for the payment gateway boilerplate.</description>

	<file>woocommerce-payment-gateway-boilerplate.php</file>
	<file>includes</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/bin/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>

	<!-- Pragmatic baseline: avoid rewriting the whole codebase in v0.9. -->
	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
		<exclude name="Generic.Files.LineEndings"/>
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
		<!-- Namespaced modern PHP; allow lighter docblocks in v0.9. -->
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamName"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamNameNoMatch"/>
		<exclude name="Squiz.Commenting.FunctionCommentThrowTag.Missing"/>
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
		<exclude name="Squiz.Commenting.VariableComment.Missing"/>
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
	</rule>

	<!-- Fail CI on errors; keep warnings informative locally. -->
	<config name="ignore_warnings_on_exit" value="1"/>
	<config name="minimum_supported_wp_version" value="6.0"/>

	<!-- WooCommerce caps used by headless REST auth. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
				<element value="edit_shop_orders"/>
			</property>
		</properties>
	</rule>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>
</ruleset>
